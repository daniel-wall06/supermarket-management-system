<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox prefHeight="330.0" prefWidth="247.0" spacing="15.0" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AddAisleController">
   <children>
      <Text text="Enter Aisle Name:" wrappingWidth="188.8203125">
         <font>
            <Font size="20.0" />
         </font>
      </Text>
      <TextField fx:id="aisleName" promptText="Aisle Name" />
      <Text text="Enter Aisle Length:" wrappingWidth="204.103515625">
         <font>
            <Font size="20.0" />
         </font>
      </Text>
      <TextField fx:id="aisleLength" prefHeight="26.0" prefWidth="73.0" promptText="Aisle Length" />
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Enter Aisle Width:" wrappingWidth="173.154296875">
         <font>
            <Font size="20.0" />
         </font>
      </Text>
      <TextField fx:id="aisleWidth" promptText="Aisle Width" />
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Enter Aisle Temperature">
         <font>
            <Font size="20.0" />
         </font>
      </Text>
      <MenuButton fx:id="aisleTemperature" mnemonicParsing="false" prefHeight="26.0" prefWidth="207.0" text="Aisle Temperature">
        <items>
          <MenuItem fx:id="aisleFrozen" mnemonicParsing="false" text="Frozen" />
          <MenuItem fx:id="aisleUnrefrigerated" mnemonicParsing="false" text="Unrefrigerated" />
            <MenuItem fx:id="aisleRefrigerated" mnemonicParsing="false" text="Refrigerated" />
        </items>
      </MenuButton>
      <Button fx:id="submitAisle" onAction="#submitAisle" prefHeight="26.0" prefWidth="216.0" style="-fx-background-color: silver;" text="Submit" underline="true" />
   </children>
</VBox>
