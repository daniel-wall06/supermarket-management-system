<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx/24.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.AddFloorAreaController"
      spacing="15.0"
      style="-fx-padding: 20;">

   <!-- Floor Area Name -->
   <Text text="Enter Floor Area Name:">
      <font>
         <Font size="20.0"/>
      </font>
   </Text>
   <TextField fx:id="floorAreaTitle" promptText="Floor Area Name"/>

   <!-- Floor Area Level -->
   <Text text="Enter Floor Area Level:">
      <font>
         <Font size="20.0"/>
      </font>
   </Text>
   <TextField fx:id="floorAreaLevel" promptText="e.g., Ground Floor"/>

   <!-- Submit Button -->
   <Button fx:id="submitFloorArea" text="Submit" onAction="#submitFloorArea"/>
</VBox>
