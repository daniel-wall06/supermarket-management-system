<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<VBox spacing="15.0" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AddShelfController">
   <children>
      <Text text="Enter Shelf Number:">
         <font>
            <Font size="20.0" />
         </font>
      </Text>
      <TextField fx:id="shelfNum" promptText="Shelf Number" />
      <Button fx:id="submitShelf" onAction="#submitShelf" text="Submit" />
   </children>
</VBox>
